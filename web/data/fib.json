"file": "examples/fib.c",
"source": "#include <stdio.h>\n\n// Числа Фібоначчі: рекурсивно та ітеративно\nint fib_rec(int n) {\n    if (n < 2) return n;\n    return fib_rec(n - 1) + fib_rec(n - 2);\n}\n\nint fib_iter(int n) {\n    int a = 0, b = 1, t;\n    while (n > 0) {\n        t = a + b;\n        a = b;\n        b = t;\n        n -= 1;\n    }\n    return a;\n}\n\nint main() {\n    int i;\n    for (i = 0; i <= 15; i++)\n        printf(\"fib(%d) = %d / %d\\n\", i, fib_rec(i), fib_iter(i));\n    return 0;\n}\n",
"python": "import sys\n\n\ndef _cdiv(a, b):\n    if b == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    q = abs(a) // abs(b)\n    return q if (a >= 0) == (b >= 0) else -q\n\n\ndef _cmod(a, b):\n    return a - _cdiv(a, b) * b\n\n\ndef _printf(fmt, *args):\n    s = fmt % args\n    sys.stdout.write(s)\n    return len(s)\n\n\ndef fib_rec(n):\n    if n < 2:\n        return n\n    return fib_rec(n - 1) + fib_rec(n - 2)\n\n\ndef fib_iter(n):\n    a = 0\n    b = 1\n    t = 0\n    while n > 0:\n        t = a + b\n        a = b\n        b = t\n        n -= 1\n    return a\n\n\ndef main():\n    i = 0\n    i = 0\n    while i <= 15:\n        _printf(\"fib(%d) = %d / %d\\n\", i, fib_rec(i), fib_iter(i))\n        i += 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n",
"output": "fib(0) = 0 / 0\nfib(1) = 1 / 1\nfib(2) = 1 / 1\nfib(3) = 2 / 2\nfib(4) = 3 / 3\nfib(5) = 5 / 5\nfib(6) = 8 / 8\nfib(7) = 13 / 13\nfib(8) = 21 / 21\nfib(9) = 34 / 34\nfib(10) = 55 / 55\nfib(11) = 89 / 89\nfib(12) = 144 / 144\nfib(13) = 233 / 233\nfib(14) = 377 / 377\nfib(15) = 610 / 610\n",

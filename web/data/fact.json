"source": "#include <stdio.h>\n\n// Рекурсивний факторіал\nint fact(int n) {\n    if (n <= 1)\n        return 1;\n    return n * fact(n - 1);\n}\n\nint main() {\n    for (int i = 1; i <= 10; i++) {\n        printf(\"%d! = %d\\n\", i, fact(i));\n    }\n    return 0;\n}\n",
"python": "import sys\n\n\ndef _cdiv(a, b):\n    if b == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    q = abs(a) // abs(b)\n    return q if (a >= 0) == (b >= 0) else -q\n\n\ndef _cmod(a, b):\n    return a - _cdiv(a, b) * b\n\n\ndef _printf(fmt, *args):\n    s = fmt % args\n    sys.stdout.write(s)\n    return len(s)\n\n\ndef fact(n):\n    if n <= 1:\n        return 1\n    return n * fact(n - 1)\n\n\ndef main():\n    i = 1\n    while i <= 10:\n        _printf(\"%d! = %d\\n\", i, fact(i))\n        i += 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n",

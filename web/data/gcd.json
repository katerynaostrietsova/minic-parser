"file": "examples/gcd.c",
"source": "#include <stdio.h>\n\n/* Алгоритм Евкліда: НСД та НСК */\nint gcd(int a, int b) {\n    while (b != 0) {\n        int r = a % b;\n        a = b;\n        b = r;\n    }\n    return a;\n}\n\nint lcm(int a, int b) {\n    return a / gcd(a, b) * b;\n}\n\nint main() {\n    printf(\"gcd(48, 18) = %d\\n\", gcd(48, 18));\n    printf(\"gcd(1071, 462) = %d\\n\", gcd(1071, 462));\n    printf(\"lcm(4, 6) = %d\\n\", lcm(4, 6));\n    printf(\"lcm(21, 6) = %d\\n\", lcm(21, 6));\n    return 0;\n}\n",
"python": "import sys\n\n\ndef _cdiv(a, b):\n    if b == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    q = abs(a) // abs(b)\n    return q if (a >= 0) == (b >= 0) else -q\n\n\ndef _cmod(a, b):\n    return a - _cdiv(a, b) * b\n\n\ndef _printf(fmt, *args):\n    s = fmt % args\n    sys.stdout.write(s)\n    return len(s)\n\n\ndef gcd(a, b):\n    while b != 0:\n        r = _cmod(a, b)\n        a = b\n        b = r\n    return a\n\n\ndef lcm(a, b):\n    return _cdiv(a, gcd(a, b)) * b\n\n\ndef main():\n    _printf(\"gcd(48, 18) = %d\\n\", gcd(48, 18))\n    _printf(\"gcd(1071, 462) = %d\\n\", gcd(1071, 462))\n    _printf(\"lcm(4, 6) = %d\\n\", lcm(4, 6))\n    _printf(\"lcm(21, 6) = %d\\n\", lcm(21, 6))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n",
"output": "gcd(48, 18) = 6\ngcd(1071, 462) = 21\nlcm(4, 6) = 12\nlcm(21, 6) = 42\n",

"file": "examples/math.c",
"source": "#include <stdio.h>\n\n// Квадратний корінь методом Ньютона\ndouble my_sqrt(double x) {\n    double g = x / 2.0;\n    for (int i = 0; i < 20; i++)\n        g = (g + x / g) / 2.0;\n    return g;\n}\n\ndouble power(double base, int e) {\n    double r = 1.0;\n    while (e > 0) {\n        r *= base;\n        e--;\n    }\n    return r;\n}\n\n// \"Висячий else\": else належить найближчому if\nvoid sign(int v) {\n    if (v >= 0)\n        if (v == 0)\n            printf(\"%d is zero\\n\", v);\n        else\n            printf(\"%d is positive\\n\", v);\n    else\n        printf(\"%d is negative\\n\", v);\n}\n\nint main() {\n    printf(\"sqrt(2) = %.6f\\n\", my_sqrt(2.0));\n    printf(\"2^10 = %.1f\\n\", power(2.0, 10));\n    printf(\"2 + 3 * 4 = %d\\n\", 2 + 3 * 4);\n    printf(\"(2 + 3) * 4 = %d\\n\", (2 + 3) * 4);\n    printf(\"10 - 4 - 3 = %d\\n\", 10 - 4 - 3);\n    printf(\"7 / 2 = %d, 7.0 / 2 = %.2f\\n\", 7 / 2, 7.0 / 2);\n    printf(\"-7 / 2 = %d, -7 %% 2 = %d\\n\", -7 / 2, -7 % 2);\n    sign(5);\n    sign(0);\n    sign(-3);\n    return 0;\n}\n",
"python": "import sys\n\n\ndef _cdiv(a, b):\n    if b == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    q = abs(a) // abs(b)\n    return q if (a >= 0) == (b >= 0) else -q\n\n\ndef _cmod(a, b):\n    return a - _cdiv(a, b) * b\n\n\ndef _printf(fmt, *args):\n    s = fmt % args\n    sys.stdout.write(s)\n    return len(s)\n\n\ndef my_sqrt(x):\n    g = x / 2.0\n    i = 0\n    while i < 20:\n        g = (g + x / g) / 2.0\n        i += 1\n    return g\n\n\ndef power(base, e):\n    r = 1.0\n    while e > 0:\n        r *= base\n        e -= 1\n    return r\n\n\ndef sign(v):\n    if v >= 0:\n        if v == 0:\n            _printf(\"%d is zero\\n\", v)\n        else:\n            _printf(\"%d is positive\\n\", v)\n    else:\n        _printf(\"%d is negative\\n\", v)\n\n\ndef main():\n    _printf(\"sqrt(2) = %.6f\\n\", my_sqrt(2.0))\n    _printf(\"2^10 = %.1f\\n\", power(2.0, 10))\n    _printf(\"2 + 3 * 4 = %d\\n\", 2 + 3 * 4)\n    _printf(\"(2 + 3) * 4 = %d\\n\", (2 + 3) * 4)\n    _printf(\"10 - 4 - 3 = %d\\n\", 10 - 4 - 3)\n    _printf(\"7 / 2 = %d, 7.0 / 2 = %.2f\\n\", _cdiv(7, 2), 7.0 / 2)\n    _printf(\"-7 / 2 = %d, -7 %% 2 = %d\\n\", _cdiv(-7, 2), _cmod(-7, 2))\n    sign(5)\n    sign(0)\n    sign(-3)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n",
"output": "sqrt(2) = 1.414214\n2^10 = 1024.0\n2 + 3 * 4 = 14\n(2 + 3) * 4 = 20\n10 - 4 - 3 = 3\n7 / 2 = 3, 7.0 / 2 = 3.50\n-7 / 2 = -3, -7 % 2 = -1\n5 is positive\n0 is zero\n-3 is negative\n",
"exit_code": 0,

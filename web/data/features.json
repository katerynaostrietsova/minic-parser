{
"file": "examples/features.c",
"source": "#include <stdio.h>\n// Демонстрація складних випадків трансляції: перекриття змінних,\n// присвоєння у виразах, ++/--, continue у for, глобальні змінні,\n// неявні перетворення типів, імена-ключові слова Python (lambda, def).\nint total = 0;\ndouble avg = 0;\nint lambda(int def) { return def * 2; }\nvoid add(int v) { total += v; }\nint main() {\n    int a = 2, b = 3, c;\n    int x = 1;\n    {\n        int x = 10;\n        x++;\n        printf(\"inner x=%d\\n\", x);\n    }\n    printf(\"outer x=%d\\n\", x);\n    c = a = b = 7;\n    printf(\"a=%d b=%d c=%d\\n\", a, b, c);\n    int i = 0;\n    while ((i += 3) < 10) printf(\"i=%d \", i);\n    printf(\"\\n\");\n    int k = 5;\n    k++;\n    ++k;\n    printf(\"k=%d\\n\", k);\n    printf(\"logic: %d %d %d %d\\n\", 2 && 3, 0 || 5, !7, !0);\n    printf(\"cmp: %d %d\\n\", (1 < 2) == 1, 3 > 2 > 1);\n    int s = 0;\n    for (int j = 0; j < 10; j++) {\n        if (j % 2 == 0) continue;\n        if (j > 7) break;\n        for (int t = 0; t < 3; t++) { if (t == 1) continue; s += t; }\n        s += j;\n    }\n    printf(\"s=%d\\n\", s);\n    for (int j = 0; j < 3; j++) add(j * 10);\n    printf(\"total=%d lambda=%d\\n\", total, lambda(21));\n    int q = 17;\n    q /= 2.5;\n    double r = 7;\n    r /= 2;\n    q %= 4;\n    printf(\"q=%d r=%.2f %d %d\\n\", q, r, -17 / 5, -17 % 5);\n    avg = total / 4;\n    printf(\"avg=%.2f %.3f\\n\", avg, total / 4.0);\n    int neg = -(-3);\n    printf(\"neg=%d %d\\n\", neg, - -neg);\n    for (;;) { if (++neg > 5) break; }\n    printf(\"neg=%d\\n\", neg);\n    if (a > 100) printf(\"big\\n\"); else if (a > 5) printf(\"mid\\n\"); else printf(\"small\\n\");\n    double big = 1e10, small = .5, tenth = 0.1;\n    printf(\"%g %g %.17g %d\\n\", big, small, tenth, 0 + 2);\n    return 0;\n}\n",
"python": "import sys\n\n\ndef _cdiv(a, b):\n    if b == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    q = abs(a) // abs(b)\n    return q if (a >= 0) == (b >= 0) else -q\n\n\ndef _cmod(a, b):\n    return a - _cdiv(a, b) * b\n\n\ndef _printf(fmt, *args):\n    s = fmt % args\n    sys.stdout.write(s)\n    return len(s)\n\n\ntotal = 0\navg = float(0)\n\n\ndef lambda_(def_):\n    return def_ * 2\n\n\ndef add(v):\n    global total\n    total += v\n\n\ndef main():\n    global avg\n    a = 2\n    b = 3\n    c = 0\n    x = 1\n    x_2 = 10\n    x_2 += 1\n    _printf(\"inner x=%d\\n\", x_2)\n    _printf(\"outer x=%d\\n\", x)\n    c = (a := (b := 7))\n    _printf(\"a=%d b=%d c=%d\\n\", a, b, c)\n    i = 0\n    while (i := i + 3) < 10:\n        _printf(\"i=%d \", i)\n    _printf(\"\\n\")\n    k = 5\n    k += 1\n    k += 1\n    _printf(\"k=%d\\n\", k)\n    _printf(\"logic: %d %d %d %d\\n\", bool(2 and 3), bool(0 or 5), not 7, not 0)\n    _printf(\"cmp: %d %d\\n\", (1 < 2) == 1, (3 > 2) > 1)\n    s = 0\n    j = 0\n    while j < 10:\n        if _cmod(j, 2) == 0:\n            j += 1\n            continue\n        if j > 7:\n            break\n        t = 0\n        while t < 3:\n            if t == 1:\n                t += 1\n                continue\n            s += t\n            t += 1\n        s += j\n        j += 1\n    _printf(\"s=%d\\n\", s)\n    j = 0\n    while j < 3:\n        add(j * 10)\n        j += 1\n    _printf(\"total=%d lambda=%d\\n\", total, lambda_(21))\n    q = 17\n    q = int(q / 2.5)\n    r = float(7)\n    r = r / 2\n    q = _cmod(q, 4)\n    _printf(\"q=%d r=%.2f %d %d\\n\", q, r, _cdiv(-17, 5), _cmod(-17, 5))\n    avg = float(_cdiv(total, 4))\n    _printf(\"avg=%.2f %.3f\\n\", avg, total / 4.0)\n    neg = -(-3)\n    _printf(\"neg=%d %d\\n\", neg, -(-neg))\n    while True:\n        if (neg := neg + 1) > 5:\n            break\n    _printf(\"neg=%d\\n\", neg)\n    if a > 100:\n        _printf(\"big\\n\")\n    elif a > 5:\n        _printf(\"mid\\n\")\n    else:\n        _printf(\"small\\n\")\n    big = 1e+10\n    small = 0.5\n    tenth = 0.1\n    _printf(\"%g %g %.17g %d\\n\", big, small, tenth, 0 + 2)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n",
"output": "inner x=11\nouter x=1\na=7 b=7 c=7\ni=3 i=6 i=9 \nk=7\nlogic: 1 1 0 1\ncmp: 1 0\ns=24\ntotal=30 lambda=42\nq=2 r=3.50 -3 -2\navg=7.00 7.500\nneg=3 3\nneg=6\nmid\n1e+10 0.5 0.10000000000000001 2\n",
